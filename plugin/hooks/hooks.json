{
  "hooks": {
    "SessionStart": [
      { "hooks": [{ "type": "command", "command": "python3 ${CLAUDE_PLUGIN_ROOT}/hooks/capture.py", "timeout": 5 }] }
    ],
    "UserPromptSubmit": [
      { "hooks": [
        { "type": "command", "command": "python3 ${CLAUDE_PLUGIN_ROOT}/hooks/capture.py", "timeout": 5 },
        { "type": "command", "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/intervene.js", "timeout": 5 }
      ] }
    ],
    "PreToolUse": [
      { "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [{ "type": "command", "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/intervene.js", "timeout": 5 }] }
    ],
    "PostToolUse": [
      { "hooks": [{ "type": "command", "command": "python3 ${CLAUDE_PLUGIN_ROOT}/hooks/capture.py", "timeout": 5 }] }
    ],
    "Stop": [
      { "hooks": [
        { "type": "command", "command": "python3 ${CLAUDE_PLUGIN_ROOT}/hooks/capture.py", "timeout": 10 },
        { "type": "command", "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/intervene.js", "timeout": 5 }
      ] }
    ],
    "SessionEnd": [
      { "hooks": [{ "type": "command", "command": "python3 ${CLAUDE_PLUGIN_ROOT}/hooks/capture.py", "timeout": 5 }] }
    ],
    "PostToolUseFailure": [
      { "hooks": [{ "type": "command", "command": "python3 ${CLAUDE_PLUGIN_ROOT}/hooks/capture.py", "timeout": 5 }] }
    ],
    "PermissionRequest": [
      { "hooks": [{ "type": "command", "command": "python3 ${CLAUDE_PLUGIN_ROOT}/hooks/capture.py", "timeout": 5 }] }
    ],
    "PreCompact": [
      { "hooks": [{ "type": "command", "command": "python3 ${CLAUDE_PLUGIN_ROOT}/hooks/capture.py", "timeout": 5 }] }
    ],
    "PostCompact": [
      { "hooks": [{ "type": "command", "command": "python3 ${CLAUDE_PLUGIN_ROOT}/hooks/capture.py", "timeout": 5 }] }
    ]
  }
}
