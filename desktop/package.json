{
  "name": "clawdacademy-desktop",
  "productName": "Clawdacademy",
  "version": "0.1.0",
  "description": "Clawdacademy — real-time AI-fluency coaching for Claude Code (desktop)",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "screenshot": "AIF_SCREENSHOT=1 electron .",
    "replay": "AIF_REPLAY=\"${AIF_REPLAY:-../fixtures/out/good-user.events.jsonl}\" electron .",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:win": "electron-builder --win --publish never",
    "dist": "electron-builder --mac --win --publish never"
  },
  "devDependencies": {
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.clawdacademy.coach",
    "productName": "Clawdacademy",
    "asar": false,
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**",
      "bootstrap/**"
    ],
    "extraResources": [
      { "from": "../coach-core", "to": "coach-core" }
    ],
    "icon": "build/icon.png",
    "mac": {
      "target": [
        { "target": "dmg", "arch": ["arm64"] }
      ],
      "identity": null,
      "category": "public.app-category.developer-tools"
    },
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Clawdacademy-Setup-${version}.${ext}"
    }
  }
}
